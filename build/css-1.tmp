
/* ===== styles.css ===== */
:root{--bg:#f4e3ce;--paper:#fffaf3;--green:#7da34b;--green-dark:#52733d;--green-soft:#e8f2df;--orange:#e98b42;--red:#b85645;--red-soft:#ffe6de;--muted:#8a705d;--line:#ead8c5;--ink:#4d3525;--wood:#9b6237;font-family:ui-rounded,"PingFang SC","Microsoft YaHei",system-ui,sans-serif;color:var(--ink)}
*{box-sizing:border-box}button,input{font:inherit}button{cursor:pointer;-webkit-tap-highlight-color:transparent}body{margin:0;min-height:100dvh;background:linear-gradient(#b97c45 0 108px,var(--bg) 108px)}
.top{position:sticky;top:0;z-index:10;padding:calc(11px + env(safe-area-inset-top)) 14px 11px;background:#995f34ee;color:#fff;display:flex;align-items:center;gap:10px;backdrop-filter:blur(12px)}.logo{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#fff3df;font-size:22px}.top-title h1{font-size:20px;margin:0}.top-title p{font-size:11px;margin:2px 0 0;opacity:.84}.grow{flex:1}.topbtn{border:0;border-radius:999px;padding:9px 10px;background:#fff5e7;color:#5c3d28;font-weight:900;display:flex;align-items:center;gap:5px}.badge{display:inline-grid;place-items:center;min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:#dc684e;color:#fff;font-size:10px}
.wrap{max-width:760px;margin:auto;padding:12px 12px 102px}.scene{border-radius:26px;padding:13px;background:linear-gradient(145deg,#edd0ae,#f8ead8);box-shadow:0 16px 35px #70462422;min-height:calc(100dvh - 178px)}h2{font-size:19px;margin:3px 2px 10px}.card{background:#fffaf3f5;border:1px solid #ffffffa8;border-radius:20px;padding:13px;margin:9px 0;box-shadow:0 6px 15px #68421f14}.head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:9px}.head b{font-size:15px}.head small,.muted{color:var(--muted);font-size:11px}
.board-tools{background:#fffaf3f5;border:1px solid #ffffffa8;border-radius:20px;padding:11px;box-shadow:0 6px 15px #68421f14}.search-row{display:flex;align-items:center;gap:7px}.search{flex:1;min-width:0;border:1px solid var(--line);background:#fff;border-radius:14px;padding:10px 11px;outline:none}.view-switch{display:flex;flex:0 0 auto;background:#f2e3d3;border:1px solid var(--line);border-radius:12px;padding:3px;gap:2px}.view-switch button{border:0;background:transparent;color:#765840;border-radius:9px;padding:6px 8px;font-weight:900;font-size:11px;min-height:32px}.view-switch button.on{background:#fff;color:var(--green-dark);box-shadow:0 2px 7px #6a452118}.filters{display:flex;gap:6px;overflow:auto;padding:9px 0 0;scrollbar-width:none}.filters::-webkit-scrollbar{display:none}.filter{white-space:nowrap;border:1px solid var(--line);border-radius:999px;background:#fff;padding:7px 10px;font-weight:800;color:#765840;font-size:12px}.filter.on{background:#e4efd9;border-color:#96b571;color:#4e7037}
.recipe-grid{display:flex;flex-wrap:wrap;gap:8px;margin-top:9px}.recipe-card{width:calc(50% - 4px);border:1px solid var(--line);border-radius:16px;background:#fff;padding:10px;text-align:left;color:var(--ink);min-height:112px;transition:.12s transform}.recipe-card:active{transform:scale(.985)}.recipe-card .icon{display:inline-block;vertical-align:middle;width:30px;font-size:24px}.recipe-card h3{display:inline-block;vertical-align:middle;width:calc(100% - 34px);margin:0;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.recipe-card p{margin:6px 0 0;color:var(--muted);font-size:10px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:27px}.meta{display:flex;gap:4px;flex-wrap:wrap;margin-top:6px}.tag{border-radius:999px;padding:4px 6px;font-size:9px;font-weight:900;background:#f5eadc;color:#785b45}.tag.good{background:#e7f1dc;color:#52743c}.tag.warn{background:#fff0d2;color:#9a671d}.tag.bad{background:#ffe3dc;color:#a84e3d}
.recipe-list{display:grid;gap:7px;margin-top:9px}.recipe-row{position:relative;width:100%;border:1px solid var(--line);border-radius:15px;background:#fff;padding:10px 88px 10px 50px;text-align:left;color:var(--ink);min-height:64px}.recipe-row .icon{position:absolute;left:10px;top:50%;transform:translateY(-50%);width:32px;font-size:26px;text-align:center}.recipe-row h3{font-size:14px;margin:0 0 3px}.recipe-row p{font-size:10px;color:var(--muted);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.row-meta{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:74px;text-align:right;display:grid;gap:4px;justify-items:end}
.primary,.secondary,.danger{border:0;border-radius:14px;padding:12px 13px;font-weight:900;min-height:44px}.primary{width:100%;background:linear-gradient(#98bb5d,#789d49);color:#fff}.primary:disabled{background:#c9c0b5}.secondary{background:#f1dfcb;color:#5d402d}.danger{background:#f7ddd7;color:#9f493a}.dual{display:flex;gap:8px}.dual>*{flex:1}
.section-title{font-size:12px;font-weight:900;margin:12px 0 6px;color:#755945;display:flex;align-items:center;gap:7px}.section-title .count{font-size:10px;color:#a2836c}.need-list{display:grid;gap:5px}.need{position:relative;border:1px solid var(--line);border-radius:13px;background:#fff;padding:8px 72px 8px 9px;display:flex;align-items:center;gap:7px;min-height:50px}.need.state-have{background:#fbfff8;border-color:#cfe0bf}.need.state-shop{background:#fffaf5;border-color:#efd0c2}.need-icon{flex:0 0 27px;font-size:20px;text-align:center}.need-info{min-width:0;flex:1}.need-info strong{display:block;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.need-info small{display:block;color:var(--muted);font-size:10px;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.optional{font-size:9px;color:#9a7455;margin-left:3px}.have-toggle{position:absolute;right:7px;top:7px;width:58px;height:34px;border:0;border-radius:11px;background:#f2e5d8;color:#735843;font-size:11px;font-weight:900}.have-toggle.on{background:#e3efda;color:#4e7038}.have-toggle.shop{background:#ffe6db;color:#a14b3b}
.tool-need{border:1px solid var(--line);border-radius:13px;background:#fff;padding:9px}.tool-head{display:flex;align-items:center;gap:7px}.tool-head strong{font-size:13px}.tool-head small{display:block;color:var(--muted);font-size:10px;margin-top:2px}.tool-status{margin-left:auto;font-size:10px;font-weight:900;color:#806650}.tool-status.have{color:var(--green-dark)}.tool-options{display:flex;gap:6px;flex-wrap:wrap;margin-top:7px}.toolbtn{border:1px solid var(--line);border-radius:999px;background:#fff7ed;padding:7px 9px;min-height:34px;font-size:11px;font-weight:800;color:#6d503b}.toolbtn.on{background:#e4f0d9;border-color:#91b36c;color:#4f7138}
.recipe-summary{display:flex;gap:6px;margin:7px 0 2px}.summary-cell{flex:1;background:#f7eadc;border-radius:11px;padding:6px 7px;text-align:center}.summary-cell b{display:block;font-size:13px}.summary-cell small{font-size:9px;color:var(--muted)}.blocker{margin-top:8px;border-radius:12px;padding:8px 9px;background:#fff0ec;color:#9d4a3c;font-size:11px;line-height:1.4}.ready{margin-top:8px;border-radius:12px;padding:8px 9px;background:#eef6e7;color:#4f7139;font-size:11px;font-weight:800}
.modal{position:fixed;inset:0;z-index:30;background:#3d291c78;display:flex;align-items:flex-end}.sheet{width:min(100%,650px);max-height:92dvh;overflow:auto;margin:auto;background:#fffaf3;border-radius:26px 26px 0 0;padding:17px}.sheet-handle{width:44px;height:5px;border-radius:99px;background:#dfcdbb;margin:-4px auto 12px}.sheet-head{display:flex;align-items:flex-start;gap:10px;margin-bottom:8px}.sheet-head .title{min-width:0;flex:1}.sheet-head .title b{font-size:18px}.sheet-head .title small{display:block;margin-top:3px;color:var(--muted);font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.icon-close{border:0;width:38px;height:38px;border-radius:50%;background:#f0dfcd;color:#654833;font-size:23px;line-height:1;font-weight:700;display:grid;place-items:center}.sheet-footer{position:sticky;bottom:-17px;margin:11px -17px -17px;padding:10px 17px calc(12px + env(safe-area-inset-bottom));background:linear-gradient(#fffaf3e8 0,#fffaf3 24%);border-top:1px solid #ead8c5;z-index:2}.sheet-footer button{min-height:46px}
.manage-tabs{display:flex;gap:5px;background:#f2e3d3;padding:4px;border-radius:13px;margin:6px 0 10px}.manage-tabs button{flex:1;border:0;background:transparent;border-radius:10px;padding:8px 4px;font-size:11px;font-weight:900;color:#765840}.manage-tabs button.on{background:#fff;color:var(--green-dark)}.picker-grid{display:flex;flex-wrap:wrap;gap:7px}.pick{border:1px solid var(--line);border-radius:999px;background:#fff;padding:8px 10px;color:#5d4332;font-weight:800;font-size:12px}.pick.on{background:#e6f0dc;border-color:#a7c28b;color:#4f7139}
.fridge-section .head{margin-bottom:8px}.fridge-actions{display:flex;gap:7px}.mini-add{border:0;border-radius:11px;background:#f1dfcb;color:#5d402d;padding:7px 9px;font-size:11px;font-weight:900}.home-grid{display:flex;flex-wrap:wrap;gap:7px}.home-item{border:1px solid var(--line);border-radius:999px;background:#fff;padding:8px 10px;font-weight:800;color:#5d4332;font-size:12px}.empty{padding:20px 9px;text-align:center;color:var(--muted);font-size:12px}
.prep-list{display:grid;gap:7px}.prep{display:grid;grid-template-columns:auto 1fr;gap:9px;align-items:start;border:1px solid var(--line);border-radius:14px;background:#fff;padding:10px}.prep.done{background:#f2f8ec;border-color:#cbdcb9}.prep-check{width:30px;height:30px;border:0;border-radius:9px;background:#eee0d1;font-weight:900;color:#72543d}.prep.done .prep-check{background:#7da34b;color:#fff}.prep strong{display:block;font-size:13px}.prep small{display:block;color:var(--muted);margin-top:3px;font-size:11px;line-height:1.4}.preflight{border-radius:13px;background:#eef6e7;color:#4f7139;padding:10px;font-size:11px;line-height:1.45;font-weight:800}.cook{background:#fffaf2;border-radius:20px;padding:13px}.step{font-size:21px;line-height:1.5;font-weight:900;margin:17px 0}.timer{background:#f8ecdd;border-radius:14px;padding:10px}.pan{height:155px;margin:12px -3px 0;border-radius:50% 50% 24% 24%;background:radial-gradient(circle at 30% 35%,#d99142 0 8%,transparent 9%),radial-gradient(circle at 57% 48%,#ad542c 0 10%,transparent 11%),radial-gradient(circle at 72% 30%,#e2a353 0 9%,transparent 10%),#4d5948;border:9px solid #68735d;box-shadow:0 14px 20px #51361e33}.actions{display:grid;grid-template-columns:1fr 1.25fr 1fr;gap:7px;margin-top:11px}.actions button{border:0;border-radius:13px;padding:11px 6px;font-weight:900}.next{background:#7da34b;color:#fff}.finish{background:#e98b42;color:#fff}.shopping-row{display:flex;align-items:center;gap:9px;border-bottom:1px solid var(--line);padding:10px 0}.shopping-row:last-child{border-bottom:0}.shopping-row .grow b{display:block;font-size:13px}.shopping-row .grow small{color:var(--muted);font-size:10px}.tiny{border:0;border-radius:11px;background:#e6f0dc;color:#4f7139;padding:8px 9px;font-weight:900;font-size:11px}.remove{border:0;border-radius:11px;background:#f0dfcd;color:#654833;padding:8px 9px;font-weight:900;font-size:11px}.toast{position:fixed;z-index:50;left:50%;bottom:91px;transform:translateX(-50%);background:#4c3628;color:#fff;padding:10px 14px;border-radius:999px;font-size:12px;white-space:nowrap;max-width:90vw;overflow:hidden;text-overflow:ellipsis}
.nav{position:fixed;z-index:20;bottom:0;left:0;right:0;padding:8px 10px calc(8px + env(safe-area-inset-bottom));background:#fffaf3ee;backdrop-filter:blur(15px);display:grid;grid-template-columns:repeat(3,1fr);box-shadow:0 -8px 22px #6d47231c}.nav button{border:0;background:none;padding:7px;color:#967760;font-weight:800}.nav button.on{color:#54783b}.nav span{display:block;font-size:21px}
@media(min-width:700px){.recipe-card{width:calc(33.333% - 6px)}.scene{padding:18px}}@media(max-width:370px){.need{padding-right:68px}.have-toggle{width:54px}.recipe-grid{gap:6px}.recipe-card{width:calc(50% - 3px)}.card{padding:11px}.topbtn span{display:none}}



/* ===== patch-v016.css ===== */
.board-mode{display:flex;gap:5px;background:#ead7c4;border:1px solid var(--line);border-radius:14px;padding:4px;margin-bottom:9px}.board-mode button{flex:1;border:0;border-radius:10px;background:transparent;padding:9px 8px;font-size:12px;font-weight:900;color:#765840}.board-mode button.on{background:#fff;color:var(--green-dark);box-shadow:0 2px 7px #6a452118}.ingredient-find{margin-top:0}.compact-foods{max-height:230px;overflow:auto;padding-right:2px}.clear-foods{border:0;border-radius:12px;background:#f1dfcb;color:#654833;padding:9px 10px;font-size:11px;font-weight:900;white-space:nowrap}.clear-foods:disabled{opacity:.45}.match-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:10px 1px 4px}.match-head b{font-size:13px}.pick{transition:background .12s,border-color .12s,color .12s}.pick.on{background:#dfeecf;border-color:#8fb16b;color:#43672f}.compact-need{width:100%;text-align:left;padding-right:52px;cursor:pointer}.compact-need.state-have{background:#e4f1d8;border-color:#9fbe7d}.compact-need.state-missing{background:#fde8e1;border-color:#dfa493}.compact-need .need-state{position:absolute;right:9px;top:50%;transform:translateY(-50%);min-width:30px;text-align:center;font-size:11px;font-weight:900}.compact-need.state-have .need-state{color:#4b7135}.compact-need.state-missing .need-state{color:#a34f3d}.compact-need:active{transform:scale(.992)}.toolbtn.off{background:#fde8e1;border-color:#dfa493;color:#9b4f3e}.toolbtn.on{background:#e4f1d8;border-color:#9fbe7d;color:#476d34}.fridge-food{position:relative;overflow:hidden}.fridge-food.delete-armed{background:#f9e1da;border-color:#da9c8b;color:#934534}.delete-progress{position:absolute;left:0;bottom:0;height:3px;width:0;background:#b85645;pointer-events:none}.fridge-food.delete-armed .delete-progress{animation:deleteWindow 1.6s linear forwards}@keyframes deleteWindow{from{width:0}to{width:100%}}@media(max-width:370px){.compact-need{padding-right:48px}.compact-foods{max-height:205px}.board-mode button{padding:8px 6px}}


/* ===== patch-v018.css ===== */
/* V0.1.8 compact recipe prerequisite sheet */
.recipe-mini-summary{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:6px 0 10px}.recipe-mini-summary .tag{font-size:10px;padding:5px 8px}.recipe-mini-summary .tag strong{font-size:11px}.recipe-mini-summary .mark-all-inline{margin-left:auto;border:0;border-radius:999px;padding:6px 9px;min-height:30px;background:#f1dfcb;color:#5d402d;font-size:10px;font-weight:900}.recipe-mini-summary .mark-all-inline.all-have{background:#e6f0dc;color:#4e7038}
.recipe-chip-section{margin:11px 0 0}.recipe-chip-title{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 1px 6px;font-size:12px;font-weight:900;color:#755945}.recipe-chip-title small{font-size:10px;color:#a2836c;font-weight:700}.recipe-chip-grid{display:flex;flex-wrap:wrap;gap:7px}
.recipe-chip{position:relative;border:1px solid var(--line);border-radius:999px;background:#fff;padding:8px 10px;min-height:38px;color:#5d4332;font-size:12px;font-weight:850;display:inline-flex;align-items:center;gap:5px;line-height:1.05;transition:background .12s,border-color .12s,transform .08s;max-width:100%}.recipe-chip:active{transform:scale(.98)}.recipe-chip .chip-icon{font-size:15px;line-height:1}.recipe-chip .chip-name{white-space:nowrap}.recipe-chip .chip-amount{font-size:9px;font-weight:800;opacity:.72;white-space:nowrap}.recipe-chip.have{background:#e6f0dc;border-color:#9fbe80;color:#486c33}.recipe-chip.missing{background:#fde8e1;border-color:#e4a995;color:#9a4637}.recipe-chip.optional-missing{background:#fffaf3;border-color:#e4d4c2;color:#806957}.recipe-chip.optional-have{background:#e6f0dc;border-color:#9fbe80;color:#486c33}
.optional-note{display:inline-flex;align-items:center;gap:4px;color:#98745a;font-size:10px;font-weight:800}.optional-dot{width:7px;height:7px;border-radius:50%;background:#d6c4b1}
.tool-chip-group{border:1px dashed #dcc8b4;border-radius:14px;padding:8px 9px;background:#fffaf4;margin-top:6px}.tool-chip-group.missing-group{border-color:#e4a995;background:#fff7f3}.tool-chip-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px}.tool-chip-head b{font-size:11px;color:#705440}.tool-chip-head small{font-size:9px;color:#96755d}.tool-chip-grid{display:flex;gap:6px;flex-wrap:wrap}.tool-chip{border:1px solid var(--line);border-radius:999px;background:#fff;padding:7px 9px;font-size:11px;font-weight:850;color:#725640;min-height:34px}.tool-chip.have{background:#e6f0dc;border-color:#9fbe80;color:#486c33}.tool-chip.missing{background:#fde8e1;border-color:#e4a995;color:#9a4637}.tool-chip.neutral{background:#fffaf3;color:#826b58}
.recipe-status-line{margin:10px 0 0;padding:8px 10px;border-radius:12px;font-size:11px;font-weight:800;line-height:1.4}.recipe-status-line.ready{background:#eef6e7;color:#4f7139}.recipe-status-line.blocked{background:#fff0ec;color:#9d4a3c}
.recipe-footer-actions{display:grid;grid-template-columns:minmax(92px,.8fr) minmax(0,1.35fr);gap:8px}.recipe-footer-actions button{width:100%;padding-left:9px;padding-right:9px;font-size:12px;white-space:normal;line-height:1.2}
@media(max-width:370px){.recipe-chip{padding:7px 8px;font-size:11px}.recipe-chip .chip-amount{font-size:8px}.recipe-footer-actions{grid-template-columns:.75fr 1.25fr}.recipe-footer-actions button{font-size:11px}.recipe-mini-summary .mark-all-inline{margin-left:0}}



/* ===== patch-v019.css ===== */
/* V0.1.11 recipe title-row bulk action */
.recipe-title-block{margin-bottom:8px}.recipe-title-row{display:flex;align-items:center;justify-content:space-between;gap:10px;min-width:0}.recipe-title-row>b{min-width:0;flex:1;font-size:18px;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.recipe-title-block>small{display:block;margin-top:4px;color:var(--muted);font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.title-bulk-add{flex:0 0 auto;border:0;border-radius:11px;background:#7da34b;color:#fff;padding:8px 11px;min-height:36px;font-size:11px;font-weight:900;box-shadow:0 3px 8px #52733d24}.title-bulk-add:active{transform:scale(.98)}.title-bulk-add.done{background:#dbe8cf;color:#66804f;box-shadow:none;cursor:default}.recipe-mini-summary{margin-top:4px;margin-bottom:8px}.recipe-mini-summary .mark-all-inline{display:none!important}
@media(max-width:370px){.recipe-title-row>b{font-size:16px}.title-bulk-add{padding:7px 9px;font-size:10px}}



/* ===== patch-v0112.css ===== */
/* V0.1.12 end-to-end interaction refinement */
.intent-browser{padding:11px}.intent-selected-line{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:10px 1px 2px}.intent-selected-line b{font-size:12px;color:#654833}.intent-selected-line span{font-size:9px;color:#9b7558}.intent-section{margin-top:10px}.intent-section-head{display:flex;align-items:center;justify-content:space-between;margin:0 1px 6px}.intent-section-head b{font-size:12px;color:#755945}.intent-section-head small{font-size:9px;color:#a2836c}.intent-food-grid{display:flex;flex-wrap:wrap;gap:7px}.intent-food{border:1px solid var(--line);border-radius:999px;padding:8px 10px;min-height:38px;background:#fff;color:#5d4332;font-size:12px;font-weight:850;display:inline-flex;align-items:center;gap:5px;box-shadow:none;transition:transform .08s,border-color .12s,box-shadow .12s}.intent-food:active{transform:scale(.98)}.intent-food.owned{background:#e6f0dc;border-color:#a7c28b;color:#4f7139}.intent-food.intent-on{border:2px solid #9b6237;padding:7px 9px;box-shadow:0 0 0 2px #f0d9c2}.intent-food small{font-size:8px;border-radius:999px;padding:2px 5px;background:#f7dfc5;color:#8b572d}.intent-empty{font-size:10px;color:#a0836e;padding:5px 2px}.match-head{margin-top:11px}
.shopping-icon{font-size:22px;flex:0 0 26px}.shopping-row .grow small{display:block;line-height:1.35;margin-top:2px;white-space:normal}.shopping-row{align-items:flex-start}.shopping-row .tiny,.shopping-row .remove{margin-top:1px}
.prep{width:100%;text-align:left;appearance:none;grid-template-columns:auto 1fr;color:var(--ink);cursor:pointer}.prep span:last-child{min-width:0}.prep-hint{margin-top:10px;padding:8px 10px;border-radius:12px;background:#fff0ec;color:#9d4a3c;font-size:11px;font-weight:800}.prep-hint.ready-hint{background:#eef6e7;color:#4f7139}.prep-card .primary:disabled{cursor:default;opacity:.72}
.compact-cook .step{margin:14px 0 10px;font-size:21px}.compact-cook .pan{height:88px;margin-top:8px;border-width:7px;opacity:.9}.actions.normal-step,.actions.last-step{grid-template-columns:1fr 1.35fr}.actions button:disabled{opacity:.45;cursor:default}.finish-sheet .sheet-head{margin-bottom:10px}.used-up-grid{display:flex;flex-wrap:wrap;gap:7px;padding-bottom:4px}.used-up-chip{border:1px solid var(--line);border-radius:999px;background:#fff;padding:8px 10px;color:#5d4332;font-size:12px;font-weight:850}.used-up-chip.on{background:#fde8e1;border-color:#d9917e;color:#964636;box-shadow:0 0 0 2px #f4d1c7}
@media(max-width:370px){.intent-food{font-size:11px;padding:7px 8px}.intent-food.intent-on{padding:6px 7px}.shopping-row{gap:6px}.shopping-row .tiny,.shopping-row .remove{padding:7px 7px;font-size:10px}.compact-cook .step{font-size:19px}}



/* ===== patch-v0113.css ===== */
/* V0.1.13 clarify recipe bulk-confirm action */
.title-bulk-add{background:#edf4e5;color:#55723f;border:1px solid #b9cf9f;box-shadow:none;min-height:34px;padding:7px 10px}
.title-bulk-add.done{background:#eef2e9;color:#718166;border-color:#d2dcc8}
.recipe-mini-summary .tag:first-child{display:inline-flex;align-items:center;gap:3px}



/* ===== patch-v0114.css ===== */
/* V0.1.14 compact bulk-confirm prompt */
.bulk-confirm-prompt{flex:0 0 auto;display:flex;align-items:center;gap:6px}
.bulk-confirm-prompt small{font-size:10px;font-weight:800;color:#8e725d;white-space:nowrap}
.bulk-confirm-prompt .title-bulk-add{background:#7da34b;color:#fff;border:0;box-shadow:0 3px 8px #52733d24;min-height:34px;padding:7px 10px}
.bulk-confirm-prompt .title-bulk-add:active{transform:scale(.98)}
.bulk-confirm-done{flex:0 0 auto;font-size:11px;font-weight:900;color:#5e7a49;white-space:nowrap;padding:7px 0}
@media(max-width:370px){.bulk-confirm-prompt{gap:4px}.bulk-confirm-prompt small{font-size:9px}.bulk-confirm-prompt .title-bulk-add{padding:6px 8px;font-size:10px}.bulk-confirm-done{font-size:10px}}



/* ===== patch-v0115.css ===== */
/* V0.1.15 scalable ingredient browsing */
.intent-subgroups{display:grid;gap:8px}.intent-subgroup{padding:8px 8px 9px;border:1px solid #ead8c5;border-radius:13px;background:#fffdf9}.intent-subgroup-head{display:flex;align-items:center;justify-content:space-between;margin:0 1px 6px}.intent-subgroup-head span{font-size:10px;font-weight:900;color:#80634c}.intent-subgroup-head small{font-size:8px;color:#aa8b72}.intent-food-subgrid{display:flex;flex-wrap:wrap;gap:6px}.intent-food-subgrid .intent-food{min-height:35px;padding:7px 9px;font-size:11px}.intent-food-subgrid .intent-food.intent-on{padding:6px 8px}
.manage-search-row{display:flex;align-items:center;gap:8px;margin:0 0 10px}.manage-search-row .search{min-height:40px}.manage-search-row>small{flex:0 0 auto;font-size:9px;color:#9b7a61;min-width:32px;text-align:right}.manage-picker{align-content:flex-start}.manage-picker .pick{min-height:36px}
@media(max-width:370px){.intent-subgroup{padding:7px}.intent-food-subgrid{gap:5px}.intent-food-subgrid .intent-food{font-size:10.5px;padding:6px 8px;min-height:33px}.intent-food-subgrid .intent-food.intent-on{padding:5px 7px}}

