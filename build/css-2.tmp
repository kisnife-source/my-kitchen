
/* ===== patch-v0116.css ===== */
/* V0.1.16 compact category browsing */
.intent-subgroup{padding:0;border:1px solid #ead8c5;border-radius:13px;background:#fffdf9;overflow:hidden}.intent-subgroup-head{margin:0;padding:10px 11px;cursor:pointer;user-select:none}.intent-subgroup-head span{font-size:11px}.intent-subgroup-head small{margin-left:auto;margin-right:8px}.intent-subgroup-chevron{font-style:normal;font-size:13px;color:#9a7659}.intent-food-subgrid{padding:0 9px 10px}.intent-subgroup.collapsed .intent-food-subgrid{display:none}.intent-subgroup.collapsed .intent-subgroup-head{background:#fffaf3}.intent-subgroup:not(.collapsed) .intent-subgroup-head{background:#f7ecdf}
.manage-food-groups{display:flex;gap:6px;overflow:auto;margin:-2px 0 10px;padding-bottom:1px;scrollbar-width:none}.manage-food-groups::-webkit-scrollbar{display:none}.manage-food-groups button{white-space:nowrap;border:1px solid #ead8c5;border-radius:999px;background:#fff;padding:7px 10px;color:#765840;font-size:10px;font-weight:900}.manage-food-groups button.on{background:#e5efdc;border-color:#9dbb7f;color:#4f703a}.manage-picker{min-height:96px}



/* ===== patch-v0117.css ===== */
/* V0.1.17 CookLikeHOC source identity */
.hoc-badge{display:inline-flex;align-items:center;gap:3px;border-radius:999px;padding:4px 7px;background:#fff0c9;border:1px solid #e6c477;color:#85581f;font-size:9px;font-weight:950;line-height:1;white-space:nowrap}.hoc-badge.short{padding:3px 6px;font-size:8px}
.recipe-card.hoc-card{border-color:#e8c98e;background:linear-gradient(180deg,#fffdf9,#fff8e9)}.hoc-card-label{display:flex;justify-content:flex-end;margin:-2px 0 5px}.recipe-card.hoc-card p{color:#8b6b50}
.recipe-row.hoc-card{border-color:#e8c98e;background:linear-gradient(90deg,#fffdf9,#fff9ec)}.recipe-row-main{min-width:0}.recipe-row-title{display:flex;align-items:center;gap:5px;min-width:0}.recipe-row-title h3{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.recipe-row-title .hoc-badge{flex:0 0 auto}
.hoc-source-filter{border-color:#e0bd76!important;background:#fff8e7!important;color:#82571f!important}.hoc-source-filter.on{background:#f5d78c!important;border-color:#c99a3f!important;color:#67400d!important}.hoc-source-filter small{font-size:8px;opacity:.75;margin-left:2px}
.recipe-load-more{display:block;width:min(100%,360px);margin:12px auto 2px;border:1px solid #ddc7ad;border-radius:14px;background:#fffaf3;color:#6d503b;padding:11px 14px;font-size:11px;font-weight:900}.recipe-load-more small{display:inline;margin-left:5px;color:#a28166;font-size:9px;font-weight:800}
.hoc-source-box{margin:8px 0 9px;padding:10px 11px;border:1px solid #e7c88b;border-radius:14px;background:linear-gradient(135deg,#fff9e9,#fffdf8)}.hoc-source-box.incomplete{border-color:#dfba9e;background:linear-gradient(135deg,#fff5ec,#fffaf6)}.hoc-source-top{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:6px}.hoc-home-scale{border-radius:999px;padding:3px 6px;background:#f2e4cd;color:#7b6047;font-size:8px;font-weight:900}.hoc-source-status{border-radius:999px;padding:3px 6px;font-size:8px;font-weight:900}.hoc-source-status.complete{background:#e8f2df;color:#53743d}.hoc-source-status.incomplete{background:#f8ded2;color:#9b4e3f}.hoc-source-text b{display:block;font-size:11px;color:#6d4b24}.hoc-source-text small{display:block;margin-top:2px;color:#91745b;font-size:9px;line-height:1.35}.hoc-source-link{display:inline-block;margin-top:7px;color:#6c7d3c;font-size:10px;font-weight:900;text-decoration:none}.hoc-source-link:active{opacity:.65}
.hoc-scene-badge{display:inline-flex;vertical-align:middle;margin-left:5px;border-radius:999px;padding:3px 6px;background:#fff0c9;border:1px solid #e6c477;color:#85581f;font-size:9px;font-weight:950}
@media(max-width:370px){.hoc-card-label{justify-content:flex-start}.recipe-row-title .hoc-badge{display:none}.hoc-source-box{padding:9px 10px}.recipe-load-more{font-size:10px}}



/* ===== patch-v0118.css ===== */
/* V0.1.18 scalable ingredient + seasoning browsing */
.intent-selected-box{margin:10px 0 2px;padding:9px 10px;border:1px solid #e6cfb8;border-radius:13px;background:#fffaf3}.intent-selected-box .intent-selected-line{margin:0 0 7px}.intent-selected-chips{display:flex;flex-wrap:wrap;gap:6px}.intent-food.intent-compact{padding:6px 8px;min-height:32px;font-size:10px}.ingredient-group-list{display:grid;gap:7px}.ingredient-group-block{border:1px solid #ead8c5;border-radius:13px;background:#fffdf9;overflow:hidden}.ingredient-group-head{width:100%;display:flex;align-items:center;gap:8px;border:0;background:#fffaf3;padding:10px 11px;color:#664a36;text-align:left;font-weight:900}.ingredient-group-head span{font-size:11px}.ingredient-group-head small{margin-left:auto;color:#9a7659;font-size:9px;font-weight:800}.ingredient-group-head i{font-style:normal;color:#9a7659;font-size:13px}.ingredient-group-block.open .ingredient-group-head{background:#f7ecdf}.ingredient-group-grid{padding:0 9px 10px}.manage-season-groups button{display:flex;align-items:center;gap:5px}.manage-season-groups button small{font-size:8px;opacity:.68}.recipe-variant{display:inline-flex;align-items:center;max-width:100%;width:max-content;margin:2px 0 0;padding:2px 6px;border-radius:999px;background:#f3eee7;color:#90735d;font-size:8px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
@media(max-width:370px){.ingredient-group-head{padding:9px 10px}.intent-selected-box{padding:8px 9px}.manage-season-groups button{padding:7px 8px}}



/* ===== patch-v0200.css ===== */
/* V0.2.0 meal planning + portions */
.meal-bar-0200{width:100%;display:flex;align-items:center;gap:10px;margin:9px 0 12px;padding:10px 12px;border:1px solid #e6cfb8;border-radius:15px;background:#fffaf3;color:#604531;text-align:left;box-shadow:0 2px 7px #6e4c2d12}.meal-bar-0200.active{border-color:#c9d9b5;background:#f7fbf1}.meal-bar-icon{font-size:22px}.meal-bar-copy{display:flex;flex-direction:column;min-width:0}.meal-bar-copy b{font-size:12px}.meal-bar-copy small{margin-top:2px;color:#9a7659;font-size:9px}.meal-bar-go{margin-left:auto;white-space:nowrap;color:#66804f;font-size:10px;font-weight:900}.meal-plan-head,.meal-serving-card,.meal-stove-summary{display:flex;align-items:center;justify-content:space-between;gap:10px}.meal-plan-head>div,.meal-serving-card>div,.meal-stove-summary>div{display:flex;flex-direction:column;min-width:0}.meal-plan-head b,.meal-serving-card b,.meal-stove-summary b{color:#573d2b;font-size:13px}.meal-plan-head small,.meal-serving-card small,.meal-stove-summary small{margin-top:3px;color:#9a7659;font-size:9px}.meal-back-select{border:0;border-radius:11px;background:#f0e6dc;color:#75553d;padding:8px 10px;font-size:10px;font-weight:900;white-space:nowrap}.meal-stepper{display:flex;align-items:center;gap:7px;flex:0 0 auto}.meal-stepper button{width:34px;height:34px;border:1px solid #dcc5ad;border-radius:11px;background:#fffdf9;color:#6e4d35;font-size:18px;font-weight:900}.meal-stepper strong{min-width:54px;text-align:center;color:#5c4432;font-size:18px}.meal-stepper strong small{margin-left:2px;font-size:9px}.meal-scale-note{margin:-3px 2px 10px;color:#a1846b;font-size:8px;line-height:1.5}.meal-section{margin:13px 0}.meal-section-title{display:flex;align-items:end;justify-content:space-between;gap:8px;margin:0 2px 7px}.meal-section-title b{color:#5b4130;font-size:12px}.meal-section-title small{color:#a08369;font-size:8px;text-align:right}.meal-list{display:grid;gap:7px}.meal-dish-row,.meal-need-row,.meal-support-row,.meal-tool-row{display:flex;align-items:center;gap:8px;padding:9px 10px;border:1px solid #ead7c2;border-radius:13px;background:#fffdf9}.meal-dish-icon,.meal-need-icon{font-size:19px;flex:0 0 auto}.meal-dish-main,.meal-need-main,.meal-support-row>div:first-child,.meal-tool-row>div:first-child{display:flex;flex-direction:column;min-width:0;flex:1}.meal-dish-main b,.meal-need-main b,.meal-support-row b,.meal-tool-row b{font-size:11px;color:#5e4432}.meal-dish-main small,.meal-need-main small,.meal-support-row small,.meal-tool-row small{margin-top:2px;font-size:8px;color:#9b7a61;line-height:1.35}.meal-mini-btn{border:1px solid #d8c4ae;border-radius:10px;background:#f7efe6;color:#75563e;padding:7px 8px;font-size:9px;font-weight:900;white-space:nowrap}.meal-mini-btn.buy{background:#f8efe2}.meal-mini-btn.make{border-color:#bfcfa9;background:#eef6e4;color:#617c49}.meal-remove{width:29px;height:29px;border:0;border-radius:9px;background:#f5e8df;color:#aa745b;font-size:15px;font-weight:900;flex:0 0 auto}.meal-state-wait,.meal-state-ok{padding:5px 7px;border-radius:999px;font-size:8px;font-weight:900;white-space:nowrap}.meal-state-wait{background:#f5e7cf;color:#a27031}.meal-state-ok{background:#e2eed7;color:#5f7e48}.meal-tool-row{align-items:flex-start;flex-direction:column}.meal-tool-options{display:flex;flex-wrap:wrap;gap:6px}.meal-tool-options button{border:1px solid #c8d6b7;border-radius:9px;background:#eef6e5;color:#5d7a45;padding:7px 8px;font-size:9px;font-weight:900}.meal-summary-card{padding:11px 12px}.meal-summary-card.ready{border-color:#c8d8b6;background:#f5faef}.meal-summary-card.blocked{border-color:#ead1b7;background:#fff9f1}.meal-summary-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.meal-summary-top>div{display:flex;flex-direction:column}.meal-summary-top b{font-size:12px;color:#5e4431}.meal-summary-top small{margin-top:3px;color:#96755d;font-size:9px}.meal-summary-top>span{min-width:30px;height:30px;border-radius:999px;display:grid;place-items:center;background:#efe3d5;color:#9a6b46;font-size:11px;font-weight:900}.meal-summary-card.ready .meal-summary-top>span{background:#dceacd;color:#607d49}.meal-wide-secondary{width:100%;margin-top:8px;border:1px solid #d6c0aa;border-radius:12px;background:#fffaf4;color:#705039;padding:10px;font-size:10px;font-weight:900}.meal-plan-actions{position:sticky;bottom:74px;z-index:4;display:grid;grid-template-columns:.8fr 1.2fr;gap:8px;margin:15px 0 4px;padding:8px;border:1px solid #ead7c3;border-radius:15px;background:#fffaf4ef;backdrop-filter:blur(8px);box-shadow:0 5px 16px #6e4b2d17}.meal-plan-actions button{min-height:42px}.meal-portion-inline{margin-top:5px;color:#9a765c;font-size:8px;font-weight:700}.meal-portion-inline b{font-size:8px;color:#68804f}.meal-prep-head{display:flex;align-items:center;justify-content:space-between;gap:8px}.meal-prep-head>div{display:flex;flex-direction:column}.meal-prep-head b{font-size:12px;color:#5b4230}.meal-prep-head small{margin-top:3px;font-size:9px;color:#9a7860}.meal-prep-support-note{margin:9px 2px;padding:8px 10px;border-radius:11px;background:#f4eddf;color:#8b6b50;font-size:9px;line-height:1.45}.meal-prep-list{display:grid;gap:7px;margin-top:10px}.meal-prep-task{width:100%;display:flex;align-items:center;gap:9px;padding:10px;border:1px solid #ead6c1;border-radius:13px;background:#fffdf9;text-align:left;color:#5b4230}.meal-prep-task.done{border-color:#c7d8b5;background:#f4faee}.meal-prep-check{width:27px;height:27px;border-radius:999px;display:grid;place-items:center;background:#f0e4d7;color:#997359;font-weight:900;flex:0 0 auto}.meal-prep-task.done .meal-prep-check{background:#dcebd0;color:#5d7b46}.meal-prep-copy{display:flex;flex-direction:column;min-width:0}.meal-prep-copy b{font-size:11px}.meal-prep-copy small{margin-top:3px;color:#9a7860;font-size:8px;line-height:1.4}.meal-prep-footer{position:sticky;bottom:74px;margin-top:13px;padding:8px;border:1px solid #ead6c1;border-radius:15px;background:#fffaf4ee;backdrop-filter:blur(8px)}.meal-prep-footer .primary{width:100%;min-height:42px}.meal-prep-status{text-align:center;margin-bottom:7px;color:#a06e4a;font-size:9px;font-weight:800}.meal-prep-status.ready{color:#63804b}.meal-next-card{display:flex;flex-direction:column;align-items:flex-start}.meal-next-card>small{font-size:9px;color:#a08066}.meal-next-card>b{margin-top:5px;font-size:16px;color:#563e2d}.meal-next-card>p{margin:4px 0 10px;font-size:9px;color:#96765e}.meal-next-card .primary{width:100%}.meal-queue-list{display:grid;gap:6px;margin:10px 0}.meal-queue-row{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:11px;background:#fffaf4;border:1px solid #ead8c7}.meal-queue-row.next{border-color:#c9d8b8;background:#f5faef}.meal-queue-row>span{width:24px;height:24px;border-radius:999px;background:#eee1d5;color:#8d6a4e;display:grid;place-items:center;font-size:9px;font-weight:900}.meal-queue-row>div{display:flex;flex-direction:column}.meal-queue-row b{font-size:10px;color:#5d4432}.meal-queue-row small{font-size:8px;color:#9a7a63}.meal-back-plan{width:100%;margin-top:4px}.meal-cook-progress{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 0 8px;padding:8px 10px;border-radius:12px;background:#f4eddf;color:#654a37}.meal-cook-progress b{font-size:10px}.meal-cook-progress span{font-size:8px;color:#927158;white-space:nowrap}.finish-sheet .used-up-grid{max-height:52vh;overflow:auto}
@media(max-width:370px){.meal-bar-0200{padding:9px 10px}.meal-plan-head,.meal-serving-card{align-items:flex-start}.meal-serving-card{gap:6px}.meal-mini-btn{padding:6px 7px}.meal-dish-row,.meal-need-row{padding:8px}.meal-plan-actions{bottom:70px}.meal-cook-progress{align-items:flex-start;flex-direction:column}.meal-cook-progress span{white-space:normal}}



/* ===== patch-v0202.css ===== */
/* V0.2.2 practical quantities */
.amount-reference-0202{font-weight:800;color:#9a6b3f}.step-amounts-0202{margin:-2px 0 12px;padding:9px 10px;border:1px solid #e7d8c8;border-radius:12px;background:#fffaf3}.step-amounts-0202>b{display:block;margin-bottom:6px;font-size:10px;color:#705039}.step-amounts-0202>div{display:flex;flex-wrap:wrap;gap:6px}.step-amounts-0202 span{display:inline-flex;max-width:100%;padding:5px 8px;border-radius:999px;background:#f3eadf;color:#715640;font-size:10px;font-weight:800;line-height:1.3;white-space:normal}
@media(max-width:370px){.step-amounts-0202{padding:8px 9px}.step-amounts-0202 span{font-size:9px;padding:5px 7px}}



/* ===== patch-v0300.css ===== */
/* V0.3.0 scalable inventory + recommendation UI */
.inventory-overview-0300{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:9px}
.inventory-overview-0300>div{background:#fffaf3;border:1px solid var(--line);border-radius:15px;padding:10px 6px;text-align:center;box-shadow:0 4px 12px #68421f10}
.inventory-overview-0300 b{display:block;font-size:18px}.inventory-overview-0300 small{display:block;margin-top:2px;color:var(--muted);font-size:9px}
.inventory-search-0300{display:flex;gap:7px;margin-bottom:7px}.inventory-search-0300 .search{min-width:0}.inventory-search-0300 button{flex:0 0 auto;border:0;border-radius:13px;background:#789d49;color:#fff;font-weight:900;padding:0 12px}
.inventory-note-0300{font-size:10px;line-height:1.45;color:#7b604c;background:#fff4df;border-radius:12px;padding:8px 10px;margin-bottom:8px}
.inventory-section-0300{margin:8px 0}.inventory-head-0300{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}.inventory-head-0300>div b{display:block;font-size:14px}.inventory-head-0300>div small{display:block;color:var(--muted);font-size:10px;margin-top:2px}
.inventory-chips-0300{display:flex;flex-wrap:wrap;gap:6px}.inventory-chip-0300{display:flex;align-items:center;gap:5px;border:1px solid var(--line);border-radius:999px;background:#fff;padding:7px 8px 7px 9px;color:var(--ink);font-size:11px}.inventory-chip-0300 b{font-size:11px}.inventory-chip-0300 i{font-style:normal;font-size:8px;background:#edf5e6;color:#57783e;border-radius:99px;padding:2px 5px}.inventory-chip-0300 em{font-style:normal;color:#a98b74;font-weight:900}
.inventory-sheet-0300{max-height:94dvh}.manage-tabs-0300{overflow:auto;scrollbar-width:none}.manage-tabs-0300::-webkit-scrollbar{display:none}.manage-tabs-0300 button{min-width:58px;white-space:nowrap}
.manage-search-0300{display:flex;align-items:center;gap:8px}.manage-search-0300 .search{min-width:0}.manage-search-0300 small{color:var(--muted);font-size:10px;white-space:nowrap}
.manage-categories-0300{display:flex;gap:6px;overflow:auto;padding:9px 0 3px;scrollbar-width:none}.manage-categories-0300::-webkit-scrollbar{display:none}.manage-categories-0300 button{white-space:nowrap;border:1px solid var(--line);border-radius:999px;background:#fff;padding:7px 9px;color:#765840;font-size:10px;font-weight:800}.manage-categories-0300 button.on{background:#e4efd9;border-color:#96b571;color:#4e7037}.manage-categories-0300 small{margin-left:4px;opacity:.65}
.manage-help-0300{margin:8px 0 3px;padding:8px 9px;border-radius:11px;background:#f5eadc;color:#745a45;font-size:10px;line-height:1.45}
.manage-picker-0300{margin-top:8px;align-content:flex-start}.picker-0300{display:flex;align-items:center;gap:5px;padding:8px 9px}.picker-0300 b{font-size:11px}.picker-0300 i{font-style:normal;margin-left:auto;font-weight:900}.picker-0300.staple-on{background:#fff3d8;border-color:#e1b85e;color:#7a5721}
.recommend-bar-0300{margin:9px 0;background:#fffaf3;border:1px solid #ead8c5;border-radius:18px;padding:11px;box-shadow:0 6px 15px #68421f12}.recommend-title-0300{display:flex;align-items:center;justify-content:space-between;gap:8px}.recommend-title-0300 b{display:block;font-size:13px}.recommend-title-0300 small{display:block;color:var(--muted);font-size:9px;margin-top:2px}.recommend-title-0300>span{font-size:9px;font-weight:900;background:#eef6e7;color:#52743c;border-radius:99px;padding:5px 7px;white-space:nowrap}.recommend-modes-0300{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-top:9px}.recommend-modes-0300 button{border:1px solid var(--line);border-radius:10px;background:#fff;padding:7px 3px;color:#765840;font-size:10px;font-weight:900}.recommend-modes-0300 button.on{background:#789d49;border-color:#789d49;color:#fff}.recommend-bar-0300 p{margin:7px 1px 0;color:var(--muted);font-size:9px}
@media(max-width:390px){.inventory-overview-0300{gap:5px}.inventory-overview-0300>div{padding:8px 3px}.inventory-search-0300 button{padding:0 9px;font-size:11px}.recommend-modes-0300{gap:4px}}



/* ===== patch-v0400.css ===== */
/* V0.4.0 cleaner shell + Home/My */
:root{--bg:#f6f3ee;--paper:#fff;--line:#e9e3da;--ink:#312c27;--muted:#82786f;--green:#6e8f4f;--green-dark:#506c3c}
body{background:var(--bg)}
.top{background:rgba(255,255,255,.94);color:var(--ink);border-bottom:1px solid var(--line);box-shadow:none;backdrop-filter:blur(14px)}
.logo{background:#f1eee8;font-size:19px}.top-title h1{font-size:18px}.top-title p{color:var(--muted);opacity:1}.topbtn{background:#f3f0ea;color:var(--ink)}
.wrap{max-width:720px;padding:14px 14px 96px}.scene{background:transparent;box-shadow:none;border-radius:0;padding:0;min-height:auto}
.card,.board-tools,.recommend-bar-0300{box-shadow:none;border-color:var(--line);background:#fff}
.nav{grid-template-columns:repeat(5,1fr);background:rgba(255,255,255,.96);border-top:1px solid var(--line);box-shadow:none;padding-top:5px}.nav button{font-size:10px;padding:5px 2px}.nav span{font-size:19px;margin-bottom:1px}.nav button.on{color:var(--green-dark)}
body.cooking-040 .nav{display:none}body.cooking-040 .wrap{padding-bottom:24px}

.home-040,.mine-040{display:grid;gap:12px}.home-hero-040{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;padding:10px 2px 6px}.home-hero-040 small{color:var(--muted);font-size:10px}.home-hero-040 h2{font-size:28px;margin:3px 0 5px}.home-hero-040 p{margin:0;color:var(--muted);font-size:11px}.home-hero-040 button{border:0;background:#e9f0e1;color:var(--green-dark);font-weight:900;border-radius:12px;padding:10px 12px;white-space:nowrap}
.continue-040{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#eaf1e4;border:1px solid #d9e5d0;border-radius:17px;padding:12px}.continue-040.soft{background:#fff;border-color:var(--line)}.continue-040 div{min-width:0}.continue-040 small,.continue-040 span{display:block;font-size:9px;color:var(--muted)}.continue-040 b{display:block;font-size:14px;margin:2px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.continue-040 button{border:0;border-radius:11px;background:var(--green);color:#fff;padding:9px 10px;font-size:10px;font-weight:900;white-space:nowrap}
.home-section-040{background:#fff;border:1px solid var(--line);border-radius:20px;padding:13px}.home-section-head-040{display:flex;align-items:center;justify-content:space-between}.home-section-head-040 h3{margin:0;font-size:15px}.home-section-head-040 p{margin:2px 0 0;color:var(--muted);font-size:9px}.home-section-head-040>button{border:0;background:transparent;color:var(--green-dark);font-size:10px;font-weight:900}
.home-modes-040{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin:11px 0 6px}.home-modes-040 button{border:0;background:#f4f1ec;border-radius:9px;padding:7px 3px;font-size:10px;color:#6f665e;font-weight:800}.home-modes-040 button.on{background:#e5edde;color:var(--green-dark)}
.home-recipe-list-040{display:grid}.home-recipe-040{border:0;border-top:1px solid var(--line);background:transparent;color:var(--ink);display:grid;grid-template-columns:24px 1fr 18px;align-items:center;gap:8px;text-align:left;padding:12px 2px}.home-recipe-040:first-child{border-top:0}.rank-040{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:#f1eee8;font-size:9px;font-weight:900}.home-recipe-copy-040 b{display:block;font-size:13px}.home-recipe-copy-040 small{display:block;color:var(--muted);font-size:9px;margin-top:3px}.arrow-040{font-size:21px;color:#b0a79f;text-align:right}
.home-empty-040{text-align:center;padding:25px 12px 17px}.home-empty-040 b{font-size:13px}.home-empty-040 p{font-size:10px;color:var(--muted);line-height:1.5}.home-empty-040 button{border:0;border-radius:11px;background:#e9f0e1;color:var(--green-dark);padding:9px 12px;font-weight:900;font-size:10px}
.home-kitchen-040{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.home-kitchen-040 button{border:0;background:transparent;padding:8px 2px;color:var(--ink)}.home-kitchen-040 b{display:block;font-size:14px}.home-kitchen-040 small{display:block;color:var(--muted);font-size:9px;margin-top:2px}

.mine-title-040{padding:10px 2px 2px}.mine-title-040 h2{font-size:24px;margin:0}.mine-title-040 p{margin:5px 0 0;color:var(--muted);font-size:11px}
.settings-card-040{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden}.settings-card-040>h3{font-size:12px;margin:0;padding:12px 13px 7px;color:#6f665e}.setting-row-040{min-height:58px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 13px;border-top:1px solid var(--line)}.setting-row-040>div:first-child{min-width:0}.setting-row-040 b{display:block;font-size:12px}.setting-row-040 small{display:block;color:var(--muted);font-size:9px;margin-top:3px}.setting-control-040{flex:0 0 auto}.setting-control-040 select{border:0;background:#f3f0eb;border-radius:9px;padding:8px 9px;font-size:10px;color:var(--ink);outline:none}
.mini-stepper-040,.segmented-040{display:flex;background:#f3f0eb;border-radius:9px;padding:2px}.mini-stepper-040 button,.segmented-040 button{border:0;background:transparent;min-width:30px;height:28px;border-radius:7px;font-size:10px;color:#6f665e;font-weight:800}.mini-stepper-040 b{display:grid;place-items:center;min-width:26px;font-size:11px}.segmented-040 button.on{background:#fff;color:var(--green-dark);box-shadow:0 1px 4px #0000000d}
.data-summary-040{display:grid;grid-template-columns:repeat(4,1fr);gap:3px;padding:9px 10px 12px}.data-summary-040 span{text-align:center;color:var(--muted);font-size:9px}.data-summary-040 b{font-size:12px;color:var(--ink);display:block;margin-bottom:2px}.settings-link-040{width:100%;border:0;border-top:1px solid var(--line);background:#fff;display:flex;align-items:center;justify-content:space-between;padding:13px;color:var(--ink);font-size:11px;text-align:left}.settings-link-040 i{font-style:normal;color:#aaa098;font-size:18px}.settings-link-040.danger span{color:#a65247}.about-040{text-align:center;padding:12px 24px;color:var(--muted)}.about-040 b{font-size:10px;color:#6f665e}.about-040 p{font-size:9px;line-height:1.55;margin:4px 0}.small-sheet-040{max-width:520px}

.recipe-grid{gap:7px}.recipe-card{box-shadow:none}.filters{padding-top:7px}.filter{background:#f7f4ef;border-color:transparent}.filter.on{border-color:transparent}.board-tools{padding:9px}.view-switch{background:#f3f0eb;border:0}
.inventory-section-0300.card{box-shadow:none}.inventory-note-0300{background:transparent;padding:3px 2px 8px}.inventory-overview-0300>div{box-shadow:none;background:#fff;border-color:var(--line)}
@media(max-width:390px){.home-hero-040 h2{font-size:25px}.home-hero-040 button{padding:9px}.setting-row-040{gap:7px}.setting-control-040 select{max-width:120px}.data-summary-040{grid-template-columns:repeat(2,1fr);row-gap:10px}}



/* ===== patch-v0401.css ===== */
/* V0.4.1: remove persistent header chrome */
.top{display:none!important}
.wrap{padding-top:calc(14px + env(safe-area-inset-top))}
.fridge-topline-041{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:2px 2px 9px}
.fridge-topline-041 h2{margin:0}
.fridge-shopping-041{border:0;background:transparent;color:var(--green-dark);font-size:10px;font-weight:900;padding:7px 4px}
.fridge-shopping-041 b{display:inline-grid;place-items:center;min-width:17px;height:17px;padding:0 4px;border-radius:999px;background:#e7ede1;color:var(--green-dark);font-size:9px;margin-left:3px}
@media(max-width:390px){.wrap{padding-top:calc(11px + env(safe-area-inset-top))}}

